{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm audit:modals:*)",
      "Bash(pnpm --filter @starium-orchestra/api typecheck:*)",
      "Bash(pnpm --filter @starium-orchestra/api test:*)",
      "Bash(pnpm --filter @starium-orchestra/api lint:*)",
      "Bash(pnpm --filter @starium-orchestra/api prisma:generate:*)",
      "Bash(pnpm --filter @starium-orchestra/web typecheck:*)",
      "Bash(pnpm --filter @starium-orchestra/web test:*)",
      "Bash(pnpm --filter @starium-orchestra/web lint:*)",
      "Bash(node scripts/audit-modals.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Read",
      "Grep",
      "Glob"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(pnpm --filter @starium-orchestra/api prisma:migrate:*)",
      "Bash(pnpm --filter @starium-orchestra/api prisma:push:*)",
      "Bash(pnpm --filter @starium-orchestra/api prisma:seed:*)",
      "Bash(docker compose:*)",
      "Bash(docker-compose:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./apps/**/.env)",
      "Read(./apps/**/.env.*)",
      "Bash(rm -rf:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)"
    ]
  }
}
